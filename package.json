{
  "name": "wedplan-server",
  "version": "1.0.0",
  "description": "Express API for WedPlan",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "tsx --test index.test.ts src/app.test.ts src/lib/services.test.ts src/lib/bookings.test.ts src/lib/profiles.test.ts src/lib/cors.test.ts src/lib/env.test.ts src/lib/payment-urls.test.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jose": "^6.0.8",
    "mongodb": "^6.12.0",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "better-auth": "^1.7.26",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
